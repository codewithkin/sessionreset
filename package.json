{
  "name": "sessionreset",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --"
  },
  "dependencies": {
    "@sessionreset/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sessionreset/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.4.0"
}
